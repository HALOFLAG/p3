{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardnarrative/schemas/intel.schema.json",
  "title": "Intel (array)",
  "description": "Phase 3 任務 14（S4）· 模組情報定義。檔案為選用；缺檔則 Module.Intel 為空 dict。",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "description"],
    "properties": {
      "id":           { "type": "string" },
      "name":         { "type": "string" },
      "description":  { "type": "string" },
      "unlocksTags":  { "type": "array", "items": { "type": "string" } }
    },
    "additionalProperties": false
  }
}

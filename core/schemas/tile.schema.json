{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardnarrative/schemas/tile.schema.json",
  "title": "Tiles (array)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "terrain", "important", "allowedActionTypes"],
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "terrain": { "enum": ["town", "wilderness", "dungeon", "special"] },
      "important": { "type": "boolean" },
      "allowedActionTypes": {
        "type": "array",
        "items": { "enum": ["communication", "combat", "exploration", "thinking"] }
      },
      "tags": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Placement tags (plan B). Empty = neutral bridge. Non-empty: at least one adjacent placed tile must share a tag."
      },
      "copies": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4,
        "default": 1,
        "description": "Number of deck copies. copies>1 seeds the same tile id consecutively in the deck and forces subsequent copies to be placed orthogonally adjacent to a previously-placed copy (forms a 2x1 / 3x1 corridor)."
      },
      "resources": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["key", "name", "perVisit"],
          "properties": {
            "key": { "type": "string" },
            "name": { "type": "string" },
            "perVisit": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "onEnter": {
        "type": "array",
        "items": { "$ref": "#/$defs/effect" }
      },
      "visualProfile": {
        "description": "Phase 2 任務 11 Stage 2a：視覺對應 profile（規格書 §2.3 / §6.3）。缺欄位時 runtime fallback 走 terrain → MapTerrain 表（wilderness→Forest / town→Building / dungeon→Mountain / special→Path）。",
        "type": "object",
        "required": ["terrain"],
        "properties": {
          "terrain": { "enum": ["Forest", "Path", "Grass", "Water", "Mountain", "Building"] },
          "minimapColor": { "type": "string", "description": "選用：自訂小地圖色塊 hex（如 #3a6830）；缺則由 MapTerrain 預設色決定" },
          "sceneTheme": { "type": "string", "description": "選用：場景立繪主題識別字（forest-day / town-night ...）" }
        },
        "additionalProperties": false
      },
      "transformations": {
        "description": "Phase 2 任務 11 Stage 5：tile-side 轉變規則（規格書 §1.5 TileTransformRule）。EventCheck 階段事件 trigger 後，runtime 從 TileTransformRegistry 索引該 triggerEventId，符合 condition 的 tile 全部變成 transformsTo。condition 缺則「無條件成立」。",
        "type": "array",
        "items": {
          "type": "object",
          "required": ["triggerEventId", "transformsTo"],
          "properties": {
            "triggerEventId": { "type": "string", "description": "觸發此規則的 event id（對應 events.json 的 id）" },
            "transformsTo": { "type": "string", "description": "目標 tile id（對應 tiles.json 中其他 tile 的 id）" },
            "condition": { "description": "選用 JsonLogic 規則；命名空間見規格書 §7.3。", "type": "object" }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "effect": {
      "oneOf": [
        { "type": "object", "required": ["type", "key", "value"],
          "properties": { "type": { "const": "setFlag" }, "key": { "type": "string" }, "value": {} },
          "additionalProperties": false },
        { "type": "object", "required": ["type", "id"],
          "properties": { "type": { "const": "grantEquipment" }, "id": { "type": "string" } },
          "additionalProperties": false },
        { "type": "object", "required": ["type", "key", "amount"],
          "properties": { "type": { "const": "grantResource" }, "key": { "type": "string" }, "amount": { "type": "integer" } },
          "additionalProperties": false },
        { "type": "object", "required": ["type", "delta"],
          "properties": { "type": { "const": "tileProgress" }, "delta": { "type": "integer" } },
          "additionalProperties": false },
        { "type": "object", "required": ["type", "battleId"],
          "properties": { "type": { "const": "triggerBattle" }, "battleId": { "type": "string" } },
          "additionalProperties": false },
        { "type": "object", "required": ["type", "amount"],
          "properties": { "type": { "const": "climaxTnIncrease" }, "amount": { "type": "integer" } },
          "additionalProperties": false },
        { "type": "object", "required": ["type", "stat", "tn"],
          "properties": {
            "type": { "const": "rollCheck" },
            "stat": { "enum": ["power", "social", "skill", "intellect"] },
            "tn": { "type": "integer" },
            "onFailure": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
          },
          "additionalProperties": false },
        { "type": "object", "required": ["type"],
          "properties": { "type": { "const": "drawEncounter" } },
          "additionalProperties": false },
        { "type": "object", "required": ["type", "newTileId"],
          "properties": {
            "type": { "const": "transformTile" },
            "newTileId": { "type": "string" },
            "x": { "type": "integer" },
            "y": { "type": "integer" },
            "preservePlayerPosition": { "type": "boolean" }
          },
          "additionalProperties": false },
        { "type": "object", "required": ["type", "tags", "newTileId"],
          "properties": {
            "type": { "const": "transformTilesByTag" },
            "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "newTileId": { "type": "string" }
          },
          "additionalProperties": false }
      ]
    }
  }
}
